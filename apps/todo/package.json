{
  "name": "@utils/todo",
  "version": "1.0.0",
  "scripts": {
    "dev": "varlock-wrangler dev --port 8081 --remote",
    "deploy": "varlock-wrangler deploy --minify",
    "cf-typegen": "varlock-wrangler types --env-interface CloudflareBindings",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:push": "varlock run -- drizzle-kit push",
    "env:load": "varlock load"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:web-utils",
    "@varlock/cloudflare-integration": "catalog:web-api",
    "drizzle-orm": "^1.0.0-beta.22",
    "hono": "catalog:web-api",
    "varlock": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^1.0.0-rc.5",
    "typescript": "catalog:",
    "wrangler": "catalog:web-api"
  }
}
