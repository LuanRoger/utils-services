{
  "name": "utils-services",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --filter './apps/*' --parallel dev",
    "start": "bun run --filter './apps/*' --parallel start",
    "build": "bun run --filter './apps/*' build",
    "env:load": "bun run --filter './apps/*' env:load",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "catalog:",
    "ultracite": "7.6.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/bun": "latest",
      "varlock": "^1.17.1"
    },
    "catalogs": {
      "web-utils": {
        "@hono/zod-validator": "^0.9.0",
        "zod": "^4.3.6"
      },
      "web-api": {
        "@varlock/cloudflare-integration": "^1.5.0",
        "hono": "^4.13.5",
        "wrangler": "^4.127.1"
      }
    }
  },
  "packageManager": "bun@1.4.2"
}
